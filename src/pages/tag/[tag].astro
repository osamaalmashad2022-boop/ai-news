---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsCard from '../../components/NewsCard.astro';
import ToolCard from '../../components/ToolCard.astro';

export async function getStaticPaths() {
  const allNews = await getCollection('news');
  const allTools = await getCollection('tools');

  const newsTags = allNews.flatMap((n) => n.data.tags || []);
  const toolTags = allTools.flatMap((t) => t.data.tags || []);
  const uniqueTags = Array.from(new Set([...newsTags, ...toolTags]));

  // Filter out tags that contain "/" — they break single-segment dynamic routes
  const safeTags = uniqueTags.filter((tag) => !tag.includes('/'));

  return safeTags.map((tag) => ({
    params: { tag },
    props: { tag },
  }));
}

const { tag } = Astro.props;

const allNews = await getCollection('news');
const filteredNews = allNews
  .filter((item) => item.data.tags?.includes(tag))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const allTools = await getCollection('tools');
const filteredTools = allTools
  .filter((tool) => tool.data.tags?.includes(tag))
  .sort((a, b) => b.data.addedAt.getTime() - a.data.addedAt.getTime());
---

<BaseLayout title={`وسم: #${tag} - نبض الذكاء AI`}>
  <div class="space-y-8 max-w-7xl mx-auto">
    <div class="border-b border-dark-border/60 pb-6 space-y-2">
      <span class="text-xs font-semibold px-3 py-1 rounded-full bg-neon-purple/10 text-neon-purple border border-neon-purple/30">
        الوسوم
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold font-heading text-white">
        #{tag}
      </h1>
      <p class="text-gray-400 text-sm">
        {filteredNews.length} خبر و {filteredTools.length} أداة
      </p>
    </div>

    {/* News Section */}
    {filteredNews.length > 0 && (
      <section class="space-y-4">
        <h2 class="text-xl font-bold font-heading text-white flex items-center gap-2">
          <span class="w-2 h-6 rounded-full bg-neon-cyan"></span>
          الأخبار
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {filteredNews.map((newsItem) => (
            <NewsCard news={newsItem} />
          ))}
        </div>
      </section>
    )}

    {/* Tools Section */}
    {filteredTools.length > 0 && (
      <section class="space-y-4">
        <h2 class="text-xl font-bold font-heading text-white flex items-center gap-2">
          <span class="w-2 h-6 rounded-full bg-neon-purple"></span>
          الأدوات
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {filteredTools.map((tool) => (
            <ToolCard tool={tool} />
          ))}
        </div>
      </section>
    )}

    {filteredNews.length === 0 && filteredTools.length === 0 && (
      <div class="glass-card p-12 text-center text-gray-400">
        لا توجد عناصر مرتبطة بهذا الوسم حالياً.
      </div>
    )}
  </div>
</BaseLayout>

